{
  "mcpServers": {
    "threads": {
      "command": "uv",
      "args": [
        "run",
        "--python",
        ">=3.12",
        "--with",
        "mcp",
        "python3",
        "skills/threads/scripts/mcp_server.py"
      ],
      "cwd": ".",
      "env": {
        "PLUGIN_DATA_DIR": "~/.codex/plugins/data/ai-workspace"
      }
    }
  }
}
